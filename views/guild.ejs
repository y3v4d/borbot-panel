<% if(is_setup) { %>
    <p>Guild is setup!</p>
    <form id="unsetup-form" action="/guild/<%= guild_id%>/unsetup" method="post">
        <input type="submit">
    </form>
<% } else { %>
    <% if(login_error) { %>
        <p>Invalid login</p>
    <% } %>
    <p>You have to setup the guild!</p>
    <form id="setup-form" action="/guild/<%= guild_id%>/setup" method="post">
        <label for="uid">Username: </label>
        <input type="text" id="uid" name="uid">
        <label for="pwd">Password Hash: </label>
        <input type="text" id="pwd" name="pwd">
        <input type="submit">
    </form>
<% } %>