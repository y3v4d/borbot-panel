<!DOCTYPE html>
<html>
    <head>
        <title>Admin Panel</title>
    </head>
    <body>
        <h1>Clicker Heroes Bot Admin Panel</h1>
        <h2>Users</h2>
        <ul>
            <% items.forEach(function(item) { %>
            <li style="display: flex;align-items: center;">
                <img width=64 height=64 src=<%= item.avatar%>>
                <p style="margin: 0;"><%= item.username %> => <%= item.clan_username %></p>
            </li>
            <% }); %>
        </ul>
    </body>
</html>